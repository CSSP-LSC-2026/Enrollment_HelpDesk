name: Rename index file

# Runs whenever you push to main, or when you click "Run workflow" in the Actions tab.
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  rename:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Rename "index 20.html" to index.html
        run: |
          found=""
          for f in "index 20.html" "index_20.html" "index-20.html" "index20.html"; do
            if [ -f "$f" ]; then
              git mv -f "$f" index.html
              found="$f"
              break
            fi
          done
          if [ -z "$found" ]; then
            echo "No index 20 file found. Nothing to rename."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git commit -m "Rename $found to index.html"
          git push
